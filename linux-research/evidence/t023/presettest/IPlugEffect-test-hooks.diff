+static void T023SaveThenLoad(iplug::IPluginBase& plug, const char* where) {
+  plug.GetParam(0)->SetNormalized(0.8);
+  bool saved = plug.SavePresetAsFXP(kT023Fxp);
+  plug.GetParam(0)->SetNormalized(0.2);
+  fprintf(stderr, "[plug] %s: saved=%d, param0 now %.4f; LoadStateFromFXP...\n", where, saved, plug.GetParam(0)->Value());
+  bool loaded = plug.LoadStateFromFXP(kT023Fxp);
+  fprintf(stderr, "[plug] %s: loaded=%d, param0 now %.4f\n", where, loaded, plug.GetParam(0)->Value());
+}
 
 
