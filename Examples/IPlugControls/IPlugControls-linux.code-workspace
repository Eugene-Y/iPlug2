{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    "cmake.copyCompileCommands": "${workspaceFolder}/build-linux/compile_commands.json",
    "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build-linux"],
    "C_Cpp.intelliSenseEngine": "disabled",
    "iplug2.reaperPath": "/opt/REAPER/reaper"
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cmake-tools",
      "llvm-vs-code-extensions.vscode-clangd",
      "ms-vscode.cpptools"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build APP",
        "type": "cmake",
        "command": "build",
        "targets": ["IPlugControls-app"],
        "preset": "${command:cmake.activeBuildPresetName}",
        "group": "build",
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "Build and deploy CLAP",
        "type": "cmake",
        "command": "build",
        "targets": ["IPlugControls-clap"],
        "preset": "${command:cmake.activeBuildPresetName}",
        "group": "build",
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "Build and deploy VST3",
        "type": "cmake",
        "command": "build",
        "targets": ["IPlugControls-vst3"],
        "preset": "${command:cmake.activeBuildPresetName}",
        "group": "build",
        "problemMatcher": ["$gcc"]
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug standalone APP",
        "type": "cppdbg",
        "request": "launch",
        "preLaunchTask": "Build APP",
        "program": "${command:cmake.buildDirectory}/out/IPlugControls",
        "cwd": "${command:cmake.buildDirectory}/out",
        "MIMode": "gdb",
        "setupCommands": [
          { "text": "-enable-pretty-printing", "ignoreFailures": true }
        ]
      },
      {
        "name": "Debug CLAP in REAPER",
        "type": "cppdbg",
        "request": "launch",
        "preLaunchTask": "Build and deploy CLAP",
        "program": "${config:iplug2.reaperPath}",
        "args": ["-newinst", "-new", "${workspaceFolder}/../../Scripts/linux/reaper-open-fx.lua"],
        "environment": [
          { "name": "IPLUG2_REAPER_FX", "value": "CLAP: IPlugControls" }
        ],
        "cwd": "${workspaceFolder}",
        "MIMode": "gdb",
        "setupCommands": [
          { "text": "-enable-pretty-printing", "ignoreFailures": true },
          { "text": "handle SIGPIPE nostop noprint", "ignoreFailures": true }
        ]
      },
      {
        "name": "Debug VST3 in REAPER",
        "type": "cppdbg",
        "request": "launch",
        "preLaunchTask": "Build and deploy VST3",
        "program": "${config:iplug2.reaperPath}",
        "args": ["-newinst", "-new", "${workspaceFolder}/../../Scripts/linux/reaper-open-fx.lua"],
        "environment": [
          { "name": "IPLUG2_REAPER_FX", "value": "VST3: IPlugControls" }
        ],
        "cwd": "${workspaceFolder}",
        "MIMode": "gdb",
        "setupCommands": [
          { "text": "-enable-pretty-printing", "ignoreFailures": true },
          { "text": "handle SIGPIPE nostop noprint", "ignoreFailures": true }
        ]
      }
    ]
  }
}
