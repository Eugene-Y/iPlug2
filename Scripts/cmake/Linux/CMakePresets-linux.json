{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "IGRAPHICS_BACKEND": "NANOVG",
        "IGRAPHICS_RENDERER": "GL2",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "IPLUG_DEPLOY_PLUGINS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Ninja, NanoVG/GL2, -O0 -g; CLAP/VST3 are copied to ~/.clap and ~/.vst3 after each build",
      "inherits": "linux-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Ninja, NanoVG/GL2, optimised; CLAP/VST3 are copied to ~/.clap and ~/.vst3 after each build",
      "inherits": "linux-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "configurePreset": "linux-release"
    }
  ]
}
